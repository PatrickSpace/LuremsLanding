rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only submitLead (Admin SDK / IAM) can access leads and the private index.
    // Deploy these rules BEFORE enabling the function/new client to close the
    // legacy addDoc route. No client may read or write registration documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
